{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/webhook.py": {
      "maxDuration": 30
    }
  },
  "schedules": {
    "automail": {
      "schedule": "*/30 8-18 * * *",
      "timezone": "America/Sao_Paulo",
      "path": "/api/cron",
      "requestMethod": "GET"
    }
  }
}
